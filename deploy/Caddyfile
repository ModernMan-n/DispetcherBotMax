# HTTPS для домена: сертификат Let's Encrypt Caddy получает и продлевает сам (через порт 80).
# HTTPS_PORT — 443 по умолчанию; другой, если 443 на сервере занят (например, VPN).
{$DOMAIN}:{$HTTPS_PORT} {
	encode gzip

	# События MAX → бот
	handle /max-webhook* {
		reverse_proxy bot:8080
	}

	# Всё остальное → дашборд
	handle {
		reverse_proxy web:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}
