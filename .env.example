# Токен от @Masterbot в MAX. Файл .env не коммитить.
MAX_BOT_TOKEN=
# SQLite на старте; для PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# ID группового чата диспетчерской (бот пишет его в чат при добавлении)
DISPATCHER_CHAT_ID=
# ID чата «Сотрудники»: ботом могут пользоваться только его участники.
# Бот должен быть администратором этого чата. Пусто — проверка выключена.
STAFF_CHAT_ID=
# Конфиг организации
ORG_CONFIG=config/org.yaml

# --- Сервер (docker compose) ---
# Домен дашборда; A-запись должна указывать на IP сервера
DOMAIN=
# Порт HTTPS. 443 по умолчанию; если 443 занят — например, 8443 (тогда адрес https://ДОМЕН:8443
# и бот через polling: BOT_MODE=polling)
HTTPS_PORT=443
# polling — на своём компьютере и на сервере, где 443 занят; webhook — на сервере с HTTPS на 443
# (в docker-compose.yml по умолчанию webhook)
BOT_MODE=polling
# Адрес для событий MAX: https://ДОМЕН/max-webhook
WEBHOOK_URL=
# Секрет webhook, 5–256 символов. Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
