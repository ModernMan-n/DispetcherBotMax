# Токен от @Masterbot в MAX. Файл .env не коммитить.
MAX_BOT_TOKEN=
# SQLite на старте; для PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# ID группового чата диспетчерской (бот пишет его в чат при добавлении)
DISPATCHER_CHAT_ID=
# Конфиг организации
ORG_CONFIG=config/org.yaml
